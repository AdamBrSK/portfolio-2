---
import Footer from "../components/Footer.astro"
import ProfesionalJourney from '../components/ProfesionalJourney.astro'
import SkillCard from "../components/SkillCard.astro"

const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Development Roadmap</title>
    <style>
        /* --- ZÁKLADNÉ ŠTÝLY (Global) --- */
        :root {
            /* Tmavé pozadie */
            --bg-color: #0a0e14;
            /* Neónové farby pre sekcie */
            --color-frontend: #00f2fe; /* Azúrová */
            --color-backend: #a145ff;  /* Fialová */
            --color-devops: #ff9f43;   /* Oranžová */
            --color-iot: #00eb8d;      /* Zelená */
            /* Neutrálne farby */
            --text-main: #ffffff;
            --text-muted: #8b9bb4;
            --card-bg: rgba(20, 26, 35, 0.8);
            --card-border: rgba(255, 255, 255, 0.08);
            --font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            padding-bottom: 100px;
        }

        /* --- HLAVIČKA (Header) --- */
        header {
            text-align: center;
            padding: 80px 20px;
        }

        .role-tag {
            display: inline-block;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-muted);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 48px;
            font-weight: 800;
            background: linear-gradient(90deg, #91c8ff 0%, #a145ff 50%, #00f2fe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
            letter-spacing: -1px;
        }

        .header-desc {
            color: var(--text-muted);
            font-size: 18px;
            max-width: 600px;
            margin: 0 auto;
        }

        /* --- HLAVNÝ KONTAJNER A ČASOVÁ OS (Timeline) --- */
        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            padding: 0 20px;
        }

        /* Vertikálna čiara časovej osi */
        .main-container::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 2px;
            background: linear-gradient(to bottom, 
                var(--color-frontend) 0%, 
                var(--color-backend) 25%, 
                var(--color-devops) 50%, 
                var(--color-iot) 75%,
                transparent 100%);
            transform: translateX(-50%);
            z-index: 1;
        }

        /* --- SEKCE (Roadmap Sections) --- */
        .roadmap-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 120px;
            position: relative;
            z-index: 2;
        }

        /* Párne sekcie (Backend, IoT) majú prehodené strany */
        .roadmap-section.even {
            flex-direction: row-reverse;
        }

        /* --- KARTY ZRUČNOSTÍ (Skill Cards - Ľavá strana pre odd, pravá pre even) --- */
        .skills-container {
            width: 45%;
        }

        .skill-card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 30px;
            position: relative;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        /* Žiara pri hoveri */
        .skill-card:hover {
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        /* Ikona teplomera (vizuálny prvok) */
        .thermometer-icon {
            position: absolute;
            top: 25px;
            left: 20px;
            width: 14px;
            height: 35px;
            background: repeating-linear-gradient(to bottom, rgba(255,255,255,0.1) 0px, rgba(255,255,255,0.1) 2px, transparent 2px, transparent 4px);
            border-radius: 7px;
        }
        .thermometer-icon::after {
            content: '';
            position: absolute;
            bottom: 2px;
            left: 2px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .skill-card h2 {
            font-size: 20px;
            margin-bottom: 25px;
            padding-left: 35px; /* Priestor pre ikonu */
        }

        /* Štýly grafu (Progress Bar) */
        .skill-item {
            margin-bottom: 20px;
            position: relative;
        }

        .skill-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .skill-name-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Neónový bod pred názvom */
        .skill-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .skill-name {
            font-size: 14px;
            color: var(--text-main);
        }

        .skill-percentage {
            font-size: 12px;
            color: var(--text-muted);
        }

        .progress-bar-bg {
            width: 100%;
            height: 6px;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 3px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            border-radius: 3px;
            width: 0; /* Animované cez JS */
            transition: width 1s ease-out;
        }

        /* --- PROJEKTOVÉ KARTY (Project Cards - Pravá strana pre odd, ľavá pre even) --- */
        .projects-container {
            width: 45%;
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 50px; /* Zarovnanie s bodom na osi */
        }

        .project-card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 25px;
            transition: transform 0.2s ease, border-color 0.3s ease;
        }

        .project-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .project-card h3 {
            font-size: 18px;
            margin-bottom: 10px;
            color: var(--text-main);
        }

        .project-card p {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 15px;
            border-left: 2px solid transparent; /* Rezerva pre neónovú čiaru */
            padding-left: 0;
            transition: border-color 0.3s ease, padding-left 0.3s ease;
        }

        /* Neónová čiara pri hoveri */
        .project-card:hover p {
            padding-left: 10px;
        }

        /* Štítky technológií (Tags) */
        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--text-muted);
            transition: color 0.2s ease, background 0.2s ease;
        }

        /* --- PÁJAČE NA OSI (Timeline Nodes) --- */
        .timeline-node {
            position: absolute;
            left: 50%;
            top: 70px; /* Zarovnané so začiatkom projektov */
            width: 12px;
            height: 12px;
            border-radius: 50%;
            transform: translateX(-50%);
            z-index: 3;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
        }

        /* --- ŠPECIFICKÉ FARBY PRE SEKCIE --- */
        /* Frontend (Odd 1) */
        .section-frontend .skill-card { border-color: rgba(0, 242, 254, 0.15); }
        .section-frontend .skill-card:hover { box-shadow: 0 10px 30px rgba(0, 242, 254, 0.15); }
        .section-frontend .thermometer-icon::after { background-color: var(--color-frontend); box-shadow: 0 0 10px var(--color-frontend); }
        .section-frontend .skill-card h2 { color: var(--color-frontend); }
        .section-frontend .skill-dot { background-color: var(--color-frontend); box-shadow: 0 0 5px var(--color-frontend); }
        .section-frontend .progress-bar-fill { background: linear-gradient(90deg, #0072ff, var(--color-frontend)); box-shadow: 0 0 10px rgba(0, 242, 254, 0.5); }
        .section-frontend .project-card:hover h3 { color: var(--color-frontend); }
        .section-frontend .project-card:hover p { border-color: var(--color-frontend); }
        .section-frontend .tag:hover { color: var(--color-frontend); background: rgba(0, 242, 254, 0.05); border-color: rgba(0, 242, 254, 0.2); }
        .section-frontend .timeline-node { background-color: var(--color-frontend); box-shadow: 0 0 15px var(--color-frontend); }

        /* Backend (Even 2) */
        .section-backend .skill-card { border-color: rgba(161, 69, 255, 0.15); }
        .section-backend .skill-card:hover { box-shadow: 0 10px 30px rgba(161, 69, 255, 0.15); }
        .section-backend .thermometer-icon::after { background-color: var(--color-backend); box-shadow: 0 0 10px var(--color-backend); }
        .section-backend .skill-card h2 { color: var(--color-backend); }
        .section-backend .skill-dot { background-color: var(--color-backend); box-shadow: 0 0 5px var(--color-backend); }
        .section-backend .progress-bar-fill { background: linear-gradient(90deg, #5500ff, var(--color-backend)); box-shadow: 0 0 10px rgba(161, 69, 255, 0.5); }
        .section-backend .project-card:hover h3 { color: var(--color-backend); }
        .section-backend .project-card:hover p { border-color: var(--color-backend); }
        .section-backend .tag:hover { color: var(--color-backend); background: rgba(161, 69, 255, 0.05); border-color: rgba(161, 69, 255, 0.2); }
        .section-backend .timeline-node { background-color: var(--color-backend); box-shadow: 0 0 15px var(--color-backend); }

        /* DevOps (Odd 3) */
        .section-devops .skill-card { border-color: rgba(255, 159, 67, 0.15); }
        .section-devops .skill-card:hover { box-shadow: 0 10px 30px rgba(255, 159, 67, 0.15); }
        .section-devops .thermometer-icon::after { background-color: var(--color-devops); box-shadow: 0 0 10px var(--color-devops); }
        .section-devops .skill-card h2 { color: var(--color-devops); }
        .section-devops .skill-dot { background-color: var(--color-devops); box-shadow: 0 0 5px var(--color-devops); }
        .section-devops .progress-bar-fill { background: linear-gradient(90deg, #ff6b6b, var(--color-devops)); box-shadow: 0 0 10px rgba(255, 159, 67, 0.5); }
        .section-devops .project-card:hover h3 { color: var(--color-devops); }
        .section-devops .project-card:hover p { border-color: var(--color-devops); }
        .section-devops .tag:hover { color: var(--color-devops); background: rgba(255, 159, 67, 0.05); border-color: rgba(255, 159, 67, 0.2); }
        .section-devops .timeline-node { background-color: var(--color-devops); box-shadow: 0 0 15px var(--color-devops); }

        /* IoT (Even 4) */
        .section-iot .skill-card { border-color: rgba(0, 235, 141, 0.15); }
        .section-iot .skill-card:hover { box-shadow: 0 10px 30px rgba(0, 235, 141, 0.15); }
        .section-iot .thermometer-icon::after { background-color: var(--color-iot); box-shadow: 0 0 10px var(--color-iot); }
        .section-iot .skill-card h2 { color: var(--color-iot); }
        .section-iot .skill-dot { background-color: var(--color-iot); box-shadow: 0 0 5px var(--color-iot); }
        .section-iot .progress-bar-fill { background: linear-gradient(90deg, #00a8cc, var(--color-iot)); box-shadow: 0 0 10px rgba(0, 235, 141, 0.5); }
        .section-iot .project-card:hover h3 { color: var(--color-iot); }
        .section-iot .project-card:hover p { border-color: var(--color-iot); }
        .section-iot .tag:hover { color: var(--color-iot); background: rgba(0, 235, 141, 0.05); border-color: rgba(0, 235, 141, 0.2); }
        .section-iot .timeline-node { background-color: var(--color-iot); box-shadow: 0 0 15px var(--color-iot); }


        /* --- RESPONSIVE DIZAJN (Mobily a Tablety) --- */
        @media (max-width: 900px) {
            h1 { font-size: 36px; }
            
            /* Posun osi na ľavý okraj */
            .main-container::before {
                left: 30px;
                transform: none;
            }

            .roadmap-section, .roadmap-section.even {
                flex-direction: column;
                align-items: flex-start;
                padding-left: 60px; /* Priestor pre os */
                margin-bottom: 80px;
            }

            .skills-container, .projects-container {
                width: 100%;
            }

            .projects-container {
                margin-top: 30px;
            }

            .timeline-node {
                left: 30px;
                top: 20px;
                transform: translateX(-50%);
            }

            footer::before {
                left: 30px;
                transform: translate(-50%, -50%);
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="role-tag">Full-Stack Engineer</div>
        <h1>Interactive Development Roadmap</h1>
        <p class="header-desc">Expertise across Frontend, Backend, DevOps, and IoT domains</p>
    </header>

    <div class="main-container">

        <div class="roadmap-section section-frontend">
            <div class="timeline-node"></div> <div class="skills-container">
                <div class="skill-card">
                    <div class="thermometer-icon"></div>
                    <h2>Frontend Development</h2>
                    
                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">React</span></div>
                            <span class="skill-percentage">95%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="95"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Next.js</span></div>
                            <span class="skill-percentage">90%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="90"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">TypeScript</span></div>
                            <span class="skill-percentage">92%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="92"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Tailwind</span></div>
                            <span class="skill-percentage">88%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="88"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Redux</span></div>
                            <span class="skill-percentage">85%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="85"></div></div>
                    </div>
                </div>
            </div>

            <div class="projects-container">
                <div class="project-card">
                    <h3>E-Commerce Platform</h3>
                    <p>Full-featured shopping experience with Next.js 14 and TypeScript</p>
                    <div class="project-tags">
                        <span class="tag">React</span><span class="tag">Next.js</span><span class="tag">TypeScript</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3>Real-time Dashboard</h3>
                    <p>Analytics platform with live data visualization</p>
                    <div class="project-tags">
                        <span class="tag">React</span><span class="tag">Redux</span><span class="tag">Tailwind</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="roadmap-section even section-backend">
            <div class="timeline-node"></div>
            
            <div class="skills-container">
                <div class="skill-card">
                    <div class="thermometer-icon"></div>
                    <h2>Backend Engineering</h2>
                    
                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Node.js</span></div>
                            <span class="skill-percentage">93%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="93"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Python</span></div>
                            <span class="skill-percentage">87%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="87"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">PostgreSQL</span></div>
                            <span class="skill-percentage">89%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="89"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Redis</span></div>
                            <span class="skill-percentage">82%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="82"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">GraphQL</span></div>
                            <span class="skill-percentage">86%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="86"></div></div>
                    </div>
                </div>
            </div>

            <div class="projects-container">
                <div class="project-card">
                    <h3>Microservices API</h3>
                    <p>Scalable REST & GraphQL API with Node.js and PostgreSQL</p>
                    <div class="project-tags">
                        <span class="tag">Node.js</span><span class="tag">GraphQL</span><span class="tag">PostgreSQL</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3>Auth System</h3>
                    <p>JWT/OAuth authentication with Redis session management</p>
                    <div class="project-tags">
                        <span class="tag">Python</span><span class="tag">Redis</span><span class="tag">JWT</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="roadmap-section section-devops">
            <div class="timeline-node"></div>
            
            <div class="skills-container">
                <div class="skill-card">
                    <div class="thermometer-icon"></div>
                    <h2>DevOps & Cloud</h2>
                    
                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Docker</span></div>
                            <span class="skill-percentage">91%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="91"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Kubernetes</span></div>
                            <span class="skill-percentage">84%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="84"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">GitHub Actions</span></div>
                            <span class="skill-percentage">88%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="88"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">AWS</span></div>
                            <span class="skill-percentage">86%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="86"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Terraform</span></div>
                            <span class="skill-percentage">83%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="83"></div></div>
                    </div>
                </div>
            </div>

            <div class="projects-container">
                <div class="project-card">
                    <h3>CI/CD Pipeline</h3>
                    <p>Automated deployment with GitHub Actions and AWS</p>
                    <div class="project-tags">
                        <span class="tag">Docker</span><span class="tag">K8s</span><span class="tag">GitHub Actions</span>
                    </div>
                </div>
                <div class="project-card">
                    <h3>Infrastructure as Code</h3>
                    <p>Multi-cloud deployment using Terraform</p>
                    <div class="project-tags">
                        <span class="tag">Terraform</span><span class="tag">AWS</span><span class="tag">Docker</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="roadmap-section even section-iot">
            <div class="timeline-node"></div>
            
            <div class="skills-container">
                <div class="skill-card">
                    <div class="thermometer-icon"></div>
                    <h2>IoT & Embedded</h2>
                    
                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">ESP32</span></div>
                            <span class="skill-percentage">90%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="90"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">MQTT</span></div>
                            <span class="skill-percentage">87%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="87"></div></div>
                    </div>

                    <div class="skill-item">
                        <div class="skill-header">
                            <div class="skill-name-wrapper"><div class="skill-dot"></div><span class="skill-name">Raspberry Pi</span></div>
                            <span class="skill-percentage">92%</span>
                        </div>
                        <div class="progress-bar-bg"><div class="progress-bar-fill" data-percent="92"></div></div>
